# The public, canonical production URL. Required to enable canonical links.
VITE_SITE_URL=https://your-domain.example

# Optional HTTPS endpoint that accepts a JSON contact form submission.
# When absent, the form opens the visitor's email client as a graceful fallback.
VITE_CONTACT_FORM_ENDPOINT=

# Server-only values. Never expose or commit real values.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ivanov-stroi?retryWrites=true&w=majority
ALLOWED_ORIGINS=https://your-domain.example
PORT=3001
NODE_ENV=production
# Set to true when the server is behind one trusted hosting proxy (Render/Railway/Fly).
TRUST_PROXY=true
